{
  "schemaVersion": "1.4.0",
  "planId": "plan-vanilla-book-v1-edit-1",
  "label": "Vanilla book, contractual only, regulatory grid",
  "authoredBy": "person",
  "asOf": "2026-03-31",
  "grid": {
    "horizonMonths": 360
  },
  "inputs": {
    "marketSnapshot": "market-public-2026-03-31",
    "positionBook": "vanilla-book-v1",
    "routingPolicy": "model-map-default-v1",
    "assumptionSets": [
      "vanilla-empty-v1"
    ]
  },
  "stages": [
    {
      "id": "st-curve",
      "component": "alm-yield-curve",
      "kind": "curve",
      "consumes": [
        "MarketSnapshot"
      ],
      "produces": [
        "ZeroCurve"
      ],
      "params": {
        "dayCount": "ACT/360"
      }
    },
    {
      "id": "st-tlp",
      "component": "alm-tlp-overlay",
      "kind": "curve",
      "consumes": [
        "ZeroCurve",
        "MarketSnapshot"
      ],
      "produces": [
        "FundingCurve"
      ],
      "params": {
        "dayCount": "ACT/360"
      },
      "dependsOn": [
        "st-curve"
      ]
    },
    {
      "id": "st-term",
      "component": "engine.rate-path",
      "kind": "term-structure",
      "consumes": [
        "ZeroCurve"
      ],
      "produces": [
        "RatePath",
        "DiscountFactorPath"
      ],
      "dependsOn": [
        "st-curve"
      ]
    },
    {
      "id": "st-cashflow",
      "component": "engine.contractual",
      "kind": "contractual-cashflow",
      "consumes": [
        "Position",
        "RatePath"
      ],
      "produces": [
        "Cashflow",
        "RepricingSchedule"
      ],
      "dependsOn": [
        "st-term"
      ]
    },
    {
      "id": "st-balance",
      "component": "engine.balance-plan",
      "kind": "balance-new-business",
      "consumes": [
        "Position",
        "RatePath",
        "Cashflow"
      ],
      "produces": [
        "Cashflow"
      ],
      "dependsOn": [
        "st-cashflow",
        "st-term"
      ]
    },
    {
      "id": "st-nii",
      "component": "alm-nii",
      "kind": "metric",
      "consumes": [
        "Cashflow"
      ],
      "produces": [
        "NiiResult"
      ],
      "dependsOn": [
        "st-balance"
      ]
    },
    {
      "id": "st-eve",
      "component": "alm-eve",
      "kind": "metric",
      "consumes": [
        "Cashflow",
        "ZeroCurve",
        "FundingCurve",
        "Position"
      ],
      "produces": [
        "EveResult"
      ],
      "dependsOn": [
        "st-curve",
        "st-tlp",
        "st-cashflow"
      ]
    },
    {
      "id": "st-gap",
      "component": "alm-gap-analytics",
      "kind": "metric",
      "consumes": [
        "Cashflow",
        "RepricingSchedule",
        "Position"
      ],
      "produces": [
        "GapResult"
      ],
      "dependsOn": [
        "st-cashflow"
      ]
    },
    {
      "id": "st-ftp",
      "component": "engine.metric.ftp",
      "kind": "metric",
      "consumes": [
        "Cashflow",
        "ZeroCurve",
        "FundingCurve",
        "Position",
        "NiiResult",
        "RatePath"
      ],
      "produces": [
        "FtpResult"
      ],
      "dependsOn": [
        "st-curve",
        "st-tlp",
        "st-term",
        "st-cashflow",
        "st-nii"
      ]
    }
  ],
  "scenarios": [
    {
      "ref": "regulatory-grid-v1#S0"
    },
    {
      "ref": "regulatory-grid-v1#S100"
    },
    {
      "ref": "regulatory-grid-v1#S-100"
    },
    {
      "ref": "regulatory-grid-v1#S200"
    },
    {
      "ref": "regulatory-grid-v1#S-200"
    }
  ],
  "reports": [
    {
      "id": "r-mgmt",
      "view": "managementView",
      "metrics": [
        "nii",
        "eve"
      ]
    }
  ],
  "validationRules": {
    "typeGate": [
      "T1",
      "T2",
      "T3",
      "T4",
      "T5"
    ],
    "routingGate": [
      "R1",
      "R2",
      "R3",
      "R4"
    ]
  },
  "scenarioBalancePlans": {
    "S0": "bp-vanilla-book-v1-edit-1"
  }
}
